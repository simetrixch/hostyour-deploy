# Agent instructions. Loaded from disk by whichever tool opens this repository, and never tracked:
# they are ours, and every machine that runs an installation clones this tree.
CLAUDE.md
AGENTS.md

# The agent's own state directory. Tooling state, never a program.
.claude/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
# setup-ai-core start: what agents and the harness put into a checkout is never committed
/.ai-core/
/GEMINI.md
/.mcp.json
/.agents/
/.openhands/microagents/
/.gemini/
/.cursorrules
/.cursor/
/.windsurfrules
/.windsurf/
/.github/copilot-instructions.md
# setup-ai-core end
